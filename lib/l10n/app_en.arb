{
  "@@locale": "en",
  "appTitle": "Converter",
  "@appTitle": {
    "description": "App name, shown in the title bar and task switcher. Keep it short."
  },
  "ratesOffline": "Offline rates · {date}",
  "@ratesOffline": {
    "description": "Subtitle under the app title when rates have never been downloaded; the built-in rates are used. {date} is the rates date (YYYY-MM-DD).",
    "placeholders": {
      "date": {
        "type": "String",
        "example": "2026-10-20"
      }
    }
  },
  "ratesUpdated": "Updated {age} · {date}",
  "@ratesUpdated": {
    "description": "Subtitle under the app title. {age} is a relative time such as \"3 h ago\" (from the age* messages), {date} is the rates date (YYYY-MM-DD).",
    "placeholders": {
      "age": {
        "type": "String",
        "example": "3 h ago"
      },
      "date": {
        "type": "String",
        "example": "2026-10-20"
      }
    }
  },
  "ageJustNow": "just now",
  "@ageJustNow": {
    "description": "Relative time, inserted mid-sentence into ratesUpdated and ratesDownloaded. Use lower case where the language allows."
  },
  "ageMinutes": "{count, plural, =1{1 min ago} other{{count} min ago}}",
  "@ageMinutes": {
    "description": "Relative time in minutes, inserted mid-sentence. Abbreviations are fine; space is tight.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "ageHours": "{count, plural, =1{1 h ago} other{{count} h ago}}",
  "@ageHours": {
    "description": "Relative time in hours, inserted mid-sentence. Abbreviations are fine; space is tight.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "ageYesterday": "yesterday",
  "@ageYesterday": {
    "description": "Relative time, inserted mid-sentence."
  },
  "ageDays": "{count, plural, =1{1 d ago} other{{count} d ago}}",
  "@ageDays": {
    "description": "Relative time in days, inserted mid-sentence. Abbreviations are fine; space is tight.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
